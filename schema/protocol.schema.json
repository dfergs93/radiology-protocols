{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protocol.schema.json",
  "title": "Imaging protocol front matter",
  "description": "YAML front matter at the top of every protocol Markdown file under docs/<modality>/. Checked in CI by scripts/validate_protocols.py. Field names are vendor-neutral: put scanner-specific product names in free-text values, not in field names.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title", "slug", "modality", "category", "protocol_type", "last_updated",
    "clinical_indications", "contrast", "series", "recons", "notes", "safety"
  ],
  "properties": {
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Must match the file name (without .md)."
    },
    "modality": {
      "enum": ["CT", "MR"],
      "description": "Must match the top-level folder: docs/ct -> CT, docs/mr -> MR."
    },
    "category": {
      "enum": ["abdomen", "cardiac", "chest", "msk", "neuro", "trauma", "vascular"],
      "description": "Body area. Must match the folder the file lives in."
    },
    "protocol_type": { "type": "string" },
    "last_updated": { "$ref": "#/$defs/date" },
    "author": { "type": ["string", "null"] },

    "last_reviewed": {
      "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }],
      "description": "Date of the most recent formal protocol review (radiologist / physicist / lead technologist). Omit or leave empty if never reviewed."
    },
    "reviewed_by": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "description": "Names and roles of the reviewers at the last review, e.g. 'Dr A Smith (Radiologist)'."
    },
    "review_interval_months": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60,
      "description": "Overrides the default review interval in config/institution.yml for this protocol."
    },

    "synonyms": { "type": "array", "items": { "type": "string" } },
    "clinical_indications": { "type": "array", "items": { "type": "string" } },
    "position": { "type": "string" },
    "npo": { "type": "string" },
    "premedication": { "type": "string" },

    "contrast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent"],
      "properties": {
        "agent": { "type": "string", "description": "Agent name, or N/A for non-contrast." },
        "type": { "type": "string" },
        "volume": { "type": "string" },
        "flow_rate": { "type": "string" },
        "duration": { "type": "string" },
        "timing": { "type": "string" },
        "roi": { "type": "string" },
        "trigger": { "type": "string" }
      }
    },

    "tech_params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kv": { "type": "string" },
        "mas": { "type": "string" },
        "pitch": { "type": "string" },
        "rotation_time": { "type": "string" }
      }
    },

    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "$ref": "#/$defs/nonEmptyString" },
          "start": { "type": "string" },
          "end": { "type": "string" },
          "delay": { "type": "string" },
          "thickness": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },

    "recons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "acquisition": { "type": "string" },
          "plane": { "type": "string" },
          "fov": { "type": "string" },
          "thickness_increment": { "type": "string" },
          "kernel": {
            "type": "string",
            "description": "Generic kernel name (Standard, Bone, Lung, Vascular...), not a vendor kernel code."
          },
          "ir_strength": {
            "type": "string",
            "description": "Iterative / deep-learning reconstruction strength. Free text so it can describe any vendor's scale."
          },
          "notes": { "type": "string" }
        }
      }
    },

    "notes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tech": { "type": "string" },
        "nursing": { "type": "string" },
        "rad": { "type": "string" },
        "tips": { "type": "string" },
        "additional_recons": { "type": "string" }
      }
    },

    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "renal": { "type": "string" },
        "allergy": { "type": "string" }
      }
    }
  },

  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
